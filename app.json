{
  "expo": {
    "name": "VoiceTimer",
    "slug": "VoiceTimer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "voicetimer",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000"
      },
      "package": "com.anonymous.VoiceTimer",
      "permissions": [
        "RECORD_AUDIO",
        "VIBRATE",
        "WAKE_LOCK"
      ]
    }
  }
}
